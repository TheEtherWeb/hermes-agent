# ── Market Data ─────────────────────────────────────────────────────────────────
# Polygon.io (primary price feed) — https://polygon.io
POLYGON_API_KEY=

# Finnhub (backup price feed + built-in sentiment) — https://finnhub.io
FINNHUB_API_KEY=

# Alpha Vantage (technical indicators) — https://www.alphavantage.co
ALPHA_VANTAGE_KEY=

# ── News ─────────────────────────────────────────────────────────────────────────
# NewsAPI (NYT, WSJ, Reuters aggregation) — https://newsapi.org
NEWSAPI_KEY=

# ── Database Credentials ──────────────────────────────────────────────────────────
POSTGRES_PASSWORD=nexus_dev
MONGO_PASSWORD=nexus_dev
# Redis password (leave empty for no auth in dev)
REDIS_PASSWORD=

# ── Service URLs (auto-set by Docker networking; override for external DBs) ──────
REDIS_URL=redis://redis:6379
TIMESCALE_URL=postgresql://nexus:nexus_dev@timescaledb:5432/nexus
MONGODB_URL=mongodb://nexus:nexus_dev@mongodb:27017/nexus?authSource=admin

# ── Frontend ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_WS_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── Symbols to Track ─────────────────────────────────────────────────────────────
WATCHED_SYMBOLS=AAPL,MSFT,GOOGL,TSLA,NVDA

# ── Algorithm Tuning ──────────────────────────────────────────────────────────────
# FinBERT inference device: 'cpu' or 'cuda:0'
FINBERT_DEVICE=cpu

# ARIMA maximum order bounds for auto-selection
ARIMA_MAX_ORDER=5

# Monte Carlo simulation paths (1000 for dev, 10000 for prod)
MONTE_CARLO_PATHS=1000

# Cross-validation frequency (every N ticks)
CROSS_VALIDATE_EVERY_N=10

# Regime reclassification frequency (every N ticks)
REGIME_CLASSIFY_EVERY_N=50

# Meta-learning rolling window (iterations)
META_LEARNING_WINDOW=500

# Maximum portfolio allocation per trade (Kelly fraction cap)
MAX_ALLOCATION=0.15

# ── Feature Flags ────────────────────────────────────────────────────────────────
# SEC EDGAR RSS feed (rate-limited; off by default in dev)
ENABLE_SEC_FEED=false
