generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Recipe {
  id          String   @id @default(cuid())
  title       String
  description String?
  cuisine     String?
  mealType    String?
  prepMinutes Int?
  cookMinutes Int?
  servings    Int?
  steps       String   // JSON array of strings
  fromScratch Boolean  @default(false)
  verified    Boolean  @default(false)
  featured    Boolean  @default(false)
  author      String?
  createdAt   DateTime @default(now())

  ingredients     RecipeIngredient[]
  cookbookEntries CookbookRecipe[]
}

model RecipeIngredient {
  id       String  @id @default(cuid())
  recipeId String
  recipe   Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  name     String  // normalized lowercase ingredient key, e.g. "tomato"
  display  String  // human-readable line, e.g. "2 ripe tomatoes, diced"

  @@index([name])
  @@index([recipeId])
}

model Cookbook {
  id          String   @id @default(cuid())
  name        String
  description String?
  author      String?
  createdAt   DateTime @default(now())

  recipes CookbookRecipe[]
}

model CookbookRecipe {
  cookbookId String
  recipeId   String
  addedAt    DateTime @default(now())
  cookbook   Cookbook @relation(fields: [cookbookId], references: [id], onDelete: Cascade)
  recipe     Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@id([cookbookId, recipeId])
  @@index([recipeId])
}
